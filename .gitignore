# Local environment and credentials; keep evidence and research data trackable.
.env
.env.*
!.env.example
apikey/
.venv/
__pycache__/
*.pyc

# Reproducible build artifacts; final releases belong in deliverables/.
/build/
/results/local/
/project/.locks/
# Release archives are GitHub assets; only their maintained instructions belong in Git.
/deliverables/*.zip
/deliverables/*.exe
/deliverables/*.bundle
