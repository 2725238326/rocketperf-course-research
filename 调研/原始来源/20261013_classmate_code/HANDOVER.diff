+static void check_staged(const RpCycleInput *input, const RpCycleResult *result)
+{
+    const double fuel = input->total_mass_flow_kg_per_s / (1.0 + input->overall_oxidizer_fuel_ratio);
+    const double oxidizer = input->total_mass_flow_kg_per_s - fuel;
+    const double pump = fuel * (input->fuel_pump.outlet_pressure_pa - input->fuel_pump.inlet_pressure_pa) /
+        (input->fuel_pump.density_kg_per_m3 * input->fuel_pump.efficiency) +
+        oxidizer * (input->oxidizer_pump.outlet_pressure_pa - input->oxidizer_pump.inlet_pressure_pa) /
+        (input->oxidizer_pump.density_kg_per_m3 * input->oxidizer_pump.efficiency);
+    const double turbine_drop = result->turbine.inlet.h_j_per_kg - result->turbine.outlet.h_j_per_kg;
+    const double branch = (pump + input->auxiliary_power_w) / input->shaft_efficiency / turbine_drop;
+    const double exit_rate = result->main_mass_flow_kg_per_s * (result->main_nozzle.exit.gas.h_j_per_kg +
+        0.5 * pow(result->main_nozzle.exit.velocity_m_per_s, 2.0));
+    CHECK(near(result->pump_power_w, pump, 1e-6));
+    CHECK(near(result->branch_mass_flow_kg_per_s, branch, 1e-10));
+    CHECK(result->branch_nozzle_active == 0 && result->branch_thrust_n == 0.0 && result->branch_throat_area_m2 == 0.0);
+    CHECK(result->external_mass_flow_kg_per_s == 0.0);
+    CHECK(result->returned_mass_flow_kg_per_s == result->branch_mass_flow_kg_per_s);
+    CHECK(near(result->main_mass_flow_kg_per_s, input->total_mass_flow_kg_per_s, 1e-12));
+    CHECK(near(result->main_mass_flow_kg_per_s, result->main_fuel_mass_flow_kg_per_s + result->main_oxidizer_mass_flow_kg_per_s, 1e-12));
+    CHECK(near(result->main_fuel_mass_flow_kg_per_s, fuel, 1e-12));
+    CHECK(near(result->main_oxidizer_fuel_ratio, input->overall_oxidizer_fuel_ratio, 1e-14));
+    CHECK(near(result->total_thrust_n, result->main_thrust_n, 1e-12));
+    CHECK(near(result->main_effective_velocity_m_per_s, result->main_nozzle.effective_velocity_m_per_s, 1e-12));
+    CHECK(near(result->engine_specific_impulse_s, result->total_thrust_n / input->total_mass_flow_kg_per_s / 9.80665, 1e-10));
+    CHECK(near(result->inlet_enthalpy_rate_w, fuel * input->fuel_pump.inlet_h_j_per_kg +
+        oxidizer * input->oxidizer_pump.inlet_h_j_per_kg, 1e-6));
+    CHECK(near(result->exit_total_enthalpy_rate_w, exit_rate, 1e-6));
+    /* Chamber inflow mixes the turbine discharge with the directly injected feed. */
+    CHECK(near(result->chamber_heat_w, result->main_mass_flow_kg_per_s * result->main_nozzle.chamber.h_j_per_kg -
+        (result->returned_mass_flow_kg_per_s * result->turbine.outlet.h_j_per_kg +
+         (fuel - result->branch_fuel_mass_flow_kg_per_s) * result->fuel_pump.outlet_h_j_per_kg +
+         (oxidizer - result->branch_oxidizer_mass_flow_kg_per_s) * result->oxidizer_pump.outlet_h_j_per_kg), 1e-3));
+    CHECK(fabs(result->mass_relative_residual) < 1e-12);
+    CHECK(fabs(result->shaft_relative_residual) < 1e-8);
+    CHECK(fabs(result->energy_relative_residual) < 1e-10);
+}
