+/* Staged closure: a high-pressure preburner drives the turbine and its exhaust
+ * is injected into a lower-pressure main chamber, so every feed stream leaves
+ * through the main nozzle. Values are declared inputs, not a real engine. */
+static RpCycleInput staged_benchmark(void)
+{
+    RpCycleInput input = benchmark();
+    input.chamber_pressure_pa = 1.0e7;
