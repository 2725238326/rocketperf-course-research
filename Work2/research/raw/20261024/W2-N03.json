{"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"GOV_PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20020085330,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"f46812a3864747c3a1679997472f1c33","belongsToAuthors":false},"subjectCategories":["Physics Of Elementary Particles And Fields"],"exportControl":{"isExportControl":"NO","submissionId":20020085330,"ear":"NO","id":"826e8ced3e314f68a3048e3820e59aed","itar":"NO"},"distributionDate":"2019-07-09T00:00:00.0000000+00:00","otherReportNumbers":["NASA/TP-2002-211556","NAS 1.60:211556","E-13336","Report Number: NASA/TP-2002-211556","Report Number: NAS 1.60:211556","Report Number: E-13336"],"fundingNumbers":[{"number":"RTOP 708-87-13","submissionId":20020085330,"id":"6ae61c6d63674afa8073fbfe0d0f07e8","type":"PROJECT"}],"title":"NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species","stiType":"TECHNICAL_PUBLICATION","distribution":"PUBLIC","submittedDate":"2013-09-07T12:54:00.0000000+00:00","authorAffiliations":[{"organizationId":"fdea3daf3b5156699f511edf3e9b9ec4","sequence":0,"submissionId":20020085330,"meta":{"author":{"name":"Bonnie J McBride"},"organization":{"name":"Glenn Research Center","location":"Cleveland, United States"}},"id":"6dffeb796ec04641a0141ae1d4c7cbc1","userType":"OTHER"},{"organizationId":"fdea3daf3b5156699f511edf3e9b9ec4","sequence":1,"submissionId":20020085330,"meta":{"author":{"name":"Michael J Zehe"},"organization":{"name":"Glenn Research Center","location":"Cleveland, United States"}},"id":"25a2a58846df4db3bc73d4ad62e05513","userType":"OTHER"},{"organizationId":"fdea3daf3b5156699f511edf3e9b9ec4","sequence":2,"submissionId":20020085330,"meta":{"author":{"name":"Sanford Gordon"},"organization":{"name":"Glenn Research Center","location":"Cleveland, United States"}},"id":"d6e247f120524eaa97e88d87301abf52","userType":"OTHER"}],"stiTypeDetails":"Technical Publication (TP)","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20020085330,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2013-09-07T12:54:00.0000000+00:00","center":{"code":"GRC","name":"Glenn Research Center","id":"19eeb25fa404421d9eaa5f876e853e3c"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"This report documents the library of thermodynamic data used with the NASA Glenn computer program CEA (Chemical Equilibrium with Applications). This library, containing data for over 2000 solid, liquid, and gaseous chemical species for temperatures ranging from 200 to 20,000 K, is available for use with other computer codes as well. The data are expressed as least-squares coefficients to a seven-term functional form for C((sup o)(sub p)) (T) / R with integration constants for H (sup o) (T) / RT and S(sup o) (T) / R. The NASA Glenn computer program PAC (Properties and Coefficients) was used to calculate thermodynamic functions and to generate the least-squares coefficients. PAC input was taken from a variety of sources. A complete listing of the database is given along with a summary of thermodynamic properties at 0 and 298.15 K.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","cui":{"isCui":false,"submissionId":20020085330,"id":"7e2821fc765146e99c0c420ef86a535d"},"publications":[{"submissionId":20020085330,"id":"e0a6d55dcacd4a659b5831ea402d5ca6","publicationDate":"2002-09-01T04:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"20020085330.pdf","type":"STI","links":{"original":"/api/citations/20020085330/downloads/20020085330.pdf","pdf":"/api/citations/20020085330/downloads/20020085330.pdf","fulltext":"/api/citations/20020085330/downloads/