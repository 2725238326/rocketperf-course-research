#report-table([推进剂方法比较结果], (3.2cm, 1fr, 1fr, 1fr),
  table.header([方法], [比冲 / s], [流量 / (kg/s)], [推力 / kN]),
  [液氧甲烷], [324.4251], [54.2637], [172.6411],
