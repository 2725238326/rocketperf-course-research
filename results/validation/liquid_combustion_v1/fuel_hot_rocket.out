  fuel=FEED_CH4 C 1 H 4 wt%=100 t,k=298.15 h,j/mole=-87404.511854646524
  oxid=FEED_O2 O 2 wt%=100 t,k=298.15 h,j/mole=-12252.605872348349
 only H2 O2 H2O CO CO2 CH4 H O OH
 output siunits trace=1.e-7
 end

